#!/usr/bin/env python3
# Kiosk touch -> screen wake, started from ~/.config/labwc/autostart.
#
# With mouseEmulation="no" in rc.xml (needed for real swiping), labwc does not
# count touches as idle activity, so swayidle never sees a tap: the screen
# never wakes and the dim/off timers never reset. This reads the touchscreen
# directly instead, and runs swayidle as a child:
#   - a tap while dimmed/off turns the screen on and restarts swayidle
#   - any tap restarts swayidle (at most every RESTART_EVERY s), which restarts
#     its timers, so dim/off count from the last touch
# swayidle still owns the timers, so a page's Wake Lock (idle inhibitor) holds.
#
# How long before dim and off comes from the dashboard (Settings > WALL KIOSK,
# GET /api/kiosk/screen-sleep), checked every minute; a change re-arms swayidle.
# Until it answers, and whenever it can't, the last timings stand (60/300 at
# boot). HTTPS is checked against the dashboard's local CA in CA_FILE.
import glob, json, os, select, signal, ssl, subprocess, time, urllib.request

SCREEN = os.path.expanduser("~/.local/bin/kiosk-screen")
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "kiosk-screen.state")
# Exported by autostart; the fallback is a placeholder that will not answer.
DASHBOARD = os.environ.get("KIOSK_DASHBOARD", "https://YOUR-SERVER-IP:3443")
CA_FILE = os.path.expanduser("~/.config/sentinelcore/ca.crt")
SETTINGS_EVERY = 60
RESTART_EVERY = 10

timings = {"dim": 60, "off": 300}


def swayidle_command():
    cmd = ["swayidle", "-w"]
    for step in ("dim", "off"):
        if timings[step] > 0:
            cmd += ["timeout", str(timings[step]), SCREEN + " " + step, "resume", SCREEN + " on"]
    # Both steps off: nothing to time, but keep a child so the loop below stays the same.
    return cmd if len(cmd) > 2 else ["sleep", "infinity"]


def fetch_timings():
    """True when the dashboard's timings differ from the ones running."""
    try:
        context = ssl.create_default_context(cafile=CA_FILE if os.path.exists(CA_FILE) else None)
        with urllib.request.urlopen(DASHBOARD + "/api/kiosk/screen-sleep", timeout=5, context=context) as r:
            body = json.load(r)
        new = {"dim": int(body["dimSeconds"]), "off": int(body["offSeconds"])}
    except Exception:
        return False
    if new == timings:
        return False
    timings.update(new)
    return True


def touch_device():
    for d in glob.glob("/sys/class/input/event*"):
        try:
            name = open(d + "/device/name").read()
        except OSError:
            continue
        if "Goodix" in name or "Touch" in name:
            return "/dev/input/" + os.path.basename(d)
    return None


def screen_state():
    try:
        return open(STATE).read().strip()
    except OSError:
        return "on"


idle = None


def restart_idle():
    global idle
    if idle and idle.poll() is None:
        idle.terminate()
        try:
            idle.wait(2)
        except subprocess.TimeoutExpired:
            idle.kill()
    idle = subprocess.Popen(swayidle_command())


def stop(*_):
    if idle and idle.poll() is None:
        idle.terminate()
    raise SystemExit(0)


signal.signal(signal.SIGTERM, stop)
fetch_timings()
restart_idle()
last_restart = last_settings = time.monotonic()
fd = None
while True:
    if time.monotonic() - last_settings >= SETTINGS_EVERY:
        last_settings = time.monotonic()
        if fetch_timings():
            # New timings start counting from now; a dark screen stays dark until touched.
            restart_idle()
    if fd is None:
        dev = touch_device()
        if dev:
            try:
                fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                fd = None
        if fd is None:
            time.sleep(5)
            continue
    if idle.poll() is not None:
        restart_idle()
    r, _, _ = select.select([fd], [], [], 5)
    if not r:
        continue
    try:
        while os.read(fd, 4096):
            pass
    except BlockingIOError:
        pass
    except OSError:
        os.close(fd)
        fd = None
        continue
    now = time.monotonic()
    if screen_state() != "on":
        subprocess.run([SCREEN, "on"])
        restart_idle()
        last_restart = now
    elif now - last_restart >= RESTART_EVERY:
        restart_idle()
        last_restart = now
