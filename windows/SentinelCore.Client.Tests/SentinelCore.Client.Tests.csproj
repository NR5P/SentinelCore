<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pinned, not "latest". These projects target net8.0-windows, but "latest" makes the
         language version follow whichever SDK happens to be installed - so a machine that gained a
         .NET 10 SDK started compiling this as C# 14, where "field" became a contextual keyword and
         an ordinary lambda parameter of that name stopped building. The target framework had not
         changed; only the compiler's idea of the language had. 12.0 is the version that ships with
         net8.0, so this now says what it always meant. -->
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>SentinelCore.Client.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real 1600x1200 JPEG, so the server's thumbnailer has work to do in the live tests. -->
    <None Include="Resources\organizer-test.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SentinelCore.Client\SentinelCore.Client.csproj" />
  </ItemGroup>

</Project>
