<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- The presentation types under test - Brush, FontStyle, the value converters - are WPF's,
         so the test assembly needs WPF too. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pinned, not "latest". These projects target net8.0-windows, but "latest" makes the
         language version follow whichever SDK happens to be installed - so a machine that gained a
         .NET 10 SDK started compiling this as C# 14, where "field" became a contextual keyword and
         an ordinary lambda parameter of that name stopped building. The target framework had not
         changed; only the compiler's idea of the language had. 12.0 is the version that ships with
         net8.0, so this now says what it always meant. -->
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>SentinelCore.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SentinelCore.App\SentinelCore.App.csproj" />
  </ItemGroup>

</Project>
