<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:design="clr-namespace:SentinelCore.App.Design">

    <!--
        Brand accent colours, and the surfaces they sit on. Everything structural stays close to
        what a Windows app is expected to behave like - focus, keyboard, selection - with Sentinel's
        green and cyan layered on as an accent rather than a full-screen reskin. Same decision the
        Apple client made when it stopped hand-painting every surface.

        The palette is the dark half of SentinelTheme.swift. A monitoring client tends to sit open
        on a screen all day, and the web dashboard it mirrors is dark too, so a single dark shell is
        the honest choice rather than a half-hearted light mode.
    -->
    <Color x:Key="GreenColor">#38FF9C</Color>
    <Color x:Key="GreenDimColor">#1F9C61</Color>
    <Color x:Key="CyanColor">#4AE8FF</Color>
    <Color x:Key="AmberColor">#FFB545</Color>
    <Color x:Key="RedColor">#FF4D5E</Color>

    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="GreenDim" Color="{StaticResource GreenDimColor}" />
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />

    <SolidColorBrush x:Key="WindowBackground" Color="#14181C" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#0E1215" />
    <SolidColorBrush x:Key="CardBackground" Color="#1B2126" />
    <SolidColorBrush x:Key="CardHoverBackground" Color="#232B31" />
    <!-- Laid over a hovered button's own background, so its label keeps the contrast it was designed with. -->
    <SolidColorBrush x:Key="HoverWash" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#2A333A" />
    <SolidColorBrush x:Key="PrimaryText" Color="#ECF1F4" />
    <SolidColorBrush x:Key="SecondaryText" Color="#93A2AD" />
    <SolidColorBrush x:Key="InputBackground" Color="#111619" />
    <SolidColorBrush x:Key="Transparent" Color="Transparent" />

    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="CaptionFontSize">11.5</sys:Double>

    <!-- ============================ Text ============================ -->

    <Style TargetType="TextBlock" x:Key="BodyText">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Caption" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="SectionTitle" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="TextBlock" x:Key="GroupHeading" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource Cyan}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- The ">_" wordmark is the one place that keeps a terminal-style monospace font on purpose:
         a logotype, not body text, so it stays a deliberate accent rather than the whole app. -->
    <Style TargetType="TextBlock" x:Key="Wordmark">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Green}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Monospace" BasedOn="{StaticResource Caption}">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============================ Cards ============================ -->

    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- ============================ Inputs ============================ -->

    <!--
        A text box that looks like one. WPF's default is a white box that fights a dark shell, and
        an unstyled one on this background is close to invisible. The border turns green while the
        field has focus, matching the Apple client's SentinelInputBox, so it is always obvious where
        typing will land.
    -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="CaretBrush" Value="{StaticResource Green}" />
        <Setter Property="SelectionBrush" Value="{StaticResource GreenDim}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Green}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource InputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="CaretBrush" Value="{StaticResource Green}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Green}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Buttons ============================ -->

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Hover lightens whatever the button's own background is, rather than
                                 swapping in the card-hover grey: that swap left PrimaryButton's dark
                                 label on a dark grey (about 1.3:1) - unreadable under the mouse. -->
                            <Border x:Name="HoverWash" Background="{StaticResource HoverWash}"
                                    CornerRadius="5" Visibility="Collapsed" />
                            <!-- Follows the button's own content alignment rather than forcing centre:
                                 a left-aligned button (the settings section list, any link button) was
                                 silently centred by a hard-coded value here. -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverWash" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource GreenDim}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Green}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource GreenDim}" />
        <Setter Property="BorderBrush" Value="{StaticResource Green}" />
        <Setter Property="Foreground" Value="#04120A" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Destructive actions read as destructive before they are clicked, not after. -->
    <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Red}" />
        <Setter Property="BorderBrush" Value="#5A2A31" />
    </Style>

    <Style TargetType="Button" x:Key="LinkButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Cyan}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="0,3" />
    </Style>

    <!-- A control that sits on top of live video. The picture behind it is arbitrary camera
         footage, so it carries its own backdrop rather than trusting whatever it lands on. -->
    <Style TargetType="Button" x:Key="OverlayButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#8C000000" />
        <Setter Property="BorderBrush" Value="#59FFFFFF" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="MinWidth" Value="38" />
    </Style>

    <!-- ============================ Toggles ============================ -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                Background="{StaticResource InputBackground}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick" Stretch="Uniform" Margin="3"
                                  Data="M 0,5 L 4,9 L 11,0"
                                  Stroke="#04120A" StrokeThickness="2.2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Green}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Green}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource GreenDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <!-- ============================ Lists and pickers ============================ -->

    <!--
        A fully templated ComboBox. WPF's stock one draws its own light chrome whatever Background
        it is given, which on this shell is a pale grey box with near-invisible text - and the
        selected value simply cannot be read. Templating it is the only way to make it belong here.
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="Background" Value="{StaticResource InputBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Shell"
                                            Background="{StaticResource InputBackground}"
                                            BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="1" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" />
                                            <TextBlock Grid.Column="1" Text="&#xE70D;" Margin="8,0,10,0"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SecondaryText}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Shell" Property="BorderBrush"
                                                    Value="{StaticResource GreenDim}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Shell" Property="BorderBrush"
                                                    Value="{StaticResource Green}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Selection"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource PrimaryText}" />

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="#171D22" BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,3,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Shell" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#22303A" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#1E3A34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The date picker, in the same clothes as everything else. Like ComboBox, the stock one draws
        its own light chrome and a white calendar popup, which on this shell is the one control that
        looks like it wandered in from another application.
    -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="CaretBrush" Value="{StaticResource Green}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Border Background="Transparent" Padding="8,6">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="Background" Value="{StaticResource InputBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Focusable="{TemplateBinding Focusable}" />

                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                    Background="Transparent" BorderThickness="0" Padding="8,0,10,0"
                                    Foreground="{StaticResource SecondaryText}">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            </Button>

                            <Popup x:Name="PART_Popup" Grid.Column="0" StaysOpen="False"
                                   AllowsTransparency="True" Placement="Bottom" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Green}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Calendar">
        <Setter Property="Background" Value="#171D22" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
    </Style>

    <Style TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
    </Style>

    <Style TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Shell" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#1E252B" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#22303A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource CardBorder}" />
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{StaticResource InputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource Green}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource Green}" />
        <Setter Property="MinWidth" Value="120" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#0B0F12" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="MaxWidth" Value="380" />
    </Style>

    <!--
        Every dialog in the app: same dark shell, same body text colour.

        WindowStartupLocation is deliberately NOT here. It is a plain CLR property on Window rather
        than a dependency property, and a Setter can only set the latter - putting it in this style
        made every single dialog throw a XamlParseException the moment it was constructed. Each
        dialog sets it on its own Window tag instead.
    -->
    <Style TargetType="Window" x:Key="Dialog">
        <Setter Property="Background" Value="{StaticResource WindowBackground}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <!-- The row of buttons along the bottom of a dialog. -->
    <Style TargetType="Border" x:Key="DialogFooter">
        <Setter Property="Background" Value="{StaticResource SidebarBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style TargetType="Border" x:Key="DialogHeader">
        <Setter Property="Background" Value="{StaticResource SidebarBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="18,14" />
    </Style>

    <Style TargetType="TextBlock" x:Key="FieldLabel" BasedOn="{StaticResource Caption}">
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!-- A small rounded label for one fact about an event: its type, its confidence, the zone that
         caught it. Collapsed by whatever builds it when there is no fact to show. -->
    <Style TargetType="Border" x:Key="Chip">
        <Setter Property="Background" Value="#1E262C" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <!-- ============================ Licence watermark ============================ -->

    <design:WatermarkFontSizeConverter x:Key="WatermarkFontSize" />

    <Style TargetType="design:UnlicensedWatermark">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="design:UnlicensedWatermark">
                    <Grid ClipToBounds="True">
                        <ContentPresenter />
                        <TextBlock x:Name="Mark"
                                   Text="UNLICENSED"
                                   Visibility="Collapsed"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Amber}"
                                   Opacity="0.4"
                                   IsHitTestVisible="False"
                                   TextWrapping="NoWrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5"
                                   FontSize="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent},
                                                      Converter={StaticResource WatermarkFontSize}}">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-16" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.7" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLicensed" Value="False">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
