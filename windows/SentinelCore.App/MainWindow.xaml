<Window x:Class="SentinelCore.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SentinelCore.App.Views"
        Title="Sentinel Core"
        Height="820" Width="1280"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <!--
            Three states, exactly as the Apple client's RootView has: no server configured yet,
            a server that wants a login, and the app proper. The version banner sits above all
            three - "this server is too old" explains a login that behaves oddly just as much as it
            explains an empty screen afterwards.
        -->
        <Grid x:Name="SetupState" Visibility="Collapsed">
            <views:ServerSetupView x:Name="SetupView" />
        </Grid>

        <Grid x:Name="LoginState" Visibility="Collapsed">
            <views:LoginView x:Name="LoginView" />
        </Grid>

        <Grid x:Name="MainState" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,16,18">
                        <TextBlock Text="&gt;_" Style="{StaticResource Wordmark}" Margin="0,0,8,0" />
                        <TextBlock Text="SENTINEL_CORE" Style="{StaticResource Wordmark}" />
                    </StackPanel>

                    <!-- The connection badge lives at the bottom of the sidebar, in view from every
                         section - the one thing a monitoring app must never make you go looking for. -->
                    <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="10,8"
                            Background="{StaticResource CardBackground}" CornerRadius="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="StatusText" Margin="8,0,0,0" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Text="Connecting…" />
                            </StackPanel>
                            <TextBlock x:Name="RouteText" Style="{StaticResource Caption}" Margin="17,3,0,0"
                                       Visibility="Collapsed" FontSize="10.5" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="SectionList" Margin="8,0" SelectionChanged="OnSectionChanged"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,9">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="15" VerticalAlignment="Center"
                                               Foreground="{StaticResource Green}" Width="24" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               Foreground="{StaticResource PrimaryText}" FontSize="13.5" />
                                    <!-- Weather's dot while an NWS warning is in force (seen or
                                         not); no brush, nothing drawn. -->
                                    <Ellipse Width="9" Height="9" Margin="8,0,0,0" VerticalAlignment="Center"
                                             Fill="{Binding AlertBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Detail -->
            <DockPanel Grid.Column="1">
                <Border x:Name="VersionBanner" DockPanel.Dock="Top" Background="#2A2214" Padding="16,10"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Amber}"
                                   VerticalAlignment="Top" Margin="0,1,10,0" />
                        <TextBlock x:Name="VersionBannerText" Style="{StaticResource Caption}" MaxWidth="900"
                                   HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- A detail pushed on top of a section - an event, or one camera - shows here
                     with a way back, rather than in a window of its own. Same shape as the Apple
                     client's navigation stack. -->
                <Border x:Name="BackBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="16,10"
                        Background="{StaticResource SidebarBackground}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Click="OnBackClicked" Padding="8,4" ToolTip="Back (Esc)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Back" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="BackBarTitle" Margin="14,0,0,0" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}"
                                   FontSize="14" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- The Music & Podcasts mini player: visible from every section while something
                     plays, or while another device offers "continue here". Built in code. -->
                <ContentControl x:Name="PlayerBarHost" DockPanel.Dock="Bottom" />

                <ContentControl x:Name="SectionHost" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
