<Window x:Class="SentinelCore.App.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Backup" Height="440" Width="560" ResizeMode="NoResize">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="360" TextWrapping="Wrap" />
                <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" Click="OnCloseClicked" />
            </Grid>
        </Border>

        <StackPanel Margin="18">
            <TextBlock Text="Backup" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Green}"
                       Margin="0,0,0,14" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="EXPORT" Style="{StaticResource GroupHeading}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Saves the server's configuration into one file you can restore later or move to another machine: settings, cameras, camera groups, trigger zones, recording schedules, gate checks, user accounts, Device Hub devices and automations, the alarm, Organizer notes, events, reminders, boards and board automations, Files backup drives, movie, music and podcast libraries with everyone's watch and listening history, and wake-up alarms. Attachments, face photos and the licence are only in the full backup made on the dashboard." />
                    <Button x:Name="ExportButton" Content="Save a backup…" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                            Click="OnExportClicked" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="RESTORE" Style="{StaticResource GroupHeading}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Nothing in the current setup that isn't mentioned in the backup is touched or removed." />
                    <Button x:Name="ImportButton" Content="Restore from a backup…" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Style="{StaticResource DangerButton}"
                            Click="OnImportClicked" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
