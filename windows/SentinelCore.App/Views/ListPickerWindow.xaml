<Window x:Class="SentinelCore.App.Views.ListPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Choose" Height="420" Width="480">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="OnCancelClicked" />
                <Button Content="Choose" Margin="10,0,0,0" MinWidth="90" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="OnChooseClicked" />
            </StackPanel>
        </Border>

        <ListBox x:Name="Items" Margin="12" MouseDoubleClick="OnChooseClicked">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="10,8" Foreground="{StaticResource PrimaryText}"
                               TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
