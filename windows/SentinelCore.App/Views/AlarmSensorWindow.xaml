<Window x:Class="SentinelCore.App.Views.AlarmSensorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Alarm sensor" Height="620" Width="520" MinHeight="480" MinWidth="440">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="260" TextWrapping="Wrap" Foreground="{StaticResource Red}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="90" Click="OnCancelClicked" />
                    <Button x:Name="SaveButton" Content="Save" Margin="10,0,0,0" MinWidth="90"
                            Style="{StaticResource PrimaryButton}" Click="OnSaveClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Green}" Margin="0,0,0,10" />

                <TextBlock Text="Device Hub device" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <ComboBox x:Name="DeviceBox" DisplayMemberPath="Label" SelectionChanged="OnDeviceChanged" />
                <TextBlock x:Name="DeviceHint" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Only devices of kind 'sensor' are offered - add the sensor on the Device Hub first (Discover finds Zigbee2MQTT ones by itself)." />

                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" />

                <TextBlock Text="What it guards" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="ZoneBox" DisplayMemberPath="Label" SelectionChanged="OnZoneChanged" />
                <TextBlock x:Name="ZoneHint" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />

                <TextBlock x:Name="WatchedHeading" Text="Watched in" Style="{StaticResource GroupHeading}" Margin="0,18,0,8" />
                <StackPanel x:Name="WatchedPanel">
                    <CheckBox x:Name="HomeToggle" Content="Home" IsChecked="True" />
                    <CheckBox x:Name="NightToggle" Content="Night" IsChecked="True" Margin="0,6,0,0" />
                    <CheckBox x:Name="AwayToggle" Content="Away" IsChecked="True" Margin="0,6,0,0" />
                </StackPanel>

                <CheckBox x:Name="InvertedToggle" Content="Reads the other way round" Margin="0,18,0,0" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Most sensors say ON for open, motion or wet. If this one shows Open while the door is shut, turn this on." />
                <CheckBox x:Name="EnabledToggle" Content="Enabled" IsChecked="True" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
