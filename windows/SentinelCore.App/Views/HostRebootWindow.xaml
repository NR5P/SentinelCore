<Window x:Class="SentinelCore.App.Views.HostRebootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Reboot the server" Height="500" Width="560" MinHeight="400" MinWidth="480">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="300" TextWrapping="Wrap" />
                <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" Click="OnCloseClicked" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <TextBlock Text="Reboot the server" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Green}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" TextWrapping="Wrap"
                           Text="Restarts the whole machine Sentinel Core runs on, not just its services. Cameras stop recording until it is back." />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="PlatformText" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                        <TextBlock x:Name="RunningAsText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- The server's own prose, not a reconstruction: which command to run, on which
                     path, for which user, is a question only the server can answer about itself,
                     and an app that guessed would eventually guess wrong on someone's install. -->
                <Border x:Name="SetupPanel" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="SETUP NEEDED" Style="{StaticResource GroupHeading}" />
                        <TextBlock x:Name="SetupNoteText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        <Border Margin="0,10,0,0" Padding="10" CornerRadius="6"
                                Background="{StaticResource InputBackground}">
                            <TextBox x:Name="SetupScriptBox" IsReadOnly="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent"
                                     FontFamily="Consolas, Courier New" FontSize="11.5" />
                        </Border>
                        <Button Content="Copy command" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Click="OnCopySetupClicked" />
                    </StackPanel>
                </Border>

                <Border x:Name="CountdownPanel" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="REBOOT SCHEDULED" Style="{StaticResource GroupHeading}" />
                        <TextBlock x:Name="CountdownText" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Amber}" FontFamily="Consolas, Courier New" />
                        <Button x:Name="CancelRebootButton" Content="Cancel the reboot" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Click="OnCancelRebootClicked" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="RebootButton" Content="Reboot now" Style="{StaticResource DangerButton}"
                            Click="OnRebootClicked" />
                    <Button Content="Re-check" Margin="10,0,0,0" Click="OnProbeClicked" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
