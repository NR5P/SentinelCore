<UserControl x:Class="SentinelCore.App.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="20,16,20,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Files" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" Text="The household's shared files" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="200" KeyDown="OnSearchKeyDown"
                         ToolTip="Search the whole library by name - press Enter" />
                <Button x:Name="AddButton" Content="Add files…" Margin="8,0,0,0" Click="OnAddClicked" />
                <Button x:Name="NewFolderButton" Content="New folder" Margin="8,0,0,0" Click="OnNewFolderClicked" />
                <Button x:Name="DrivesButton" Content="Backup drives" Margin="8,0,0,0" Click="OnDrivesClicked" />
                <Button x:Name="TrashButton" Content="Trash" Margin="8,0,0,0" Click="OnTrashWindowClicked" />
                <Button Margin="8,0,0,0" Padding="10,6" Click="OnRefreshClicked" ToolTip="Refresh now">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Where in the library we are: a button per folder on the way down, and a way up. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="BackButton" DockPanel.Dock="Left" Padding="8,4" Click="OnBackClicked"
                    ToolTip="Up one folder" IsEnabled="False">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
            </Button>
            <StackPanel x:Name="Crumbs" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <!-- The server is busy in the background: a backup, a restore, a duplicate check. -->
        <Border x:Name="JobBanner" DockPanel.Dock="Top" Background="#14241C" CornerRadius="6" Padding="14,10"
                Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="JobText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                <ProgressBar x:Name="JobProgress" Margin="0,8,0,0" Minimum="0" Maximum="1" />
            </StackPanel>
        </Border>

        <!-- This PC's own transfer: an upload in progress, or a download on its way to being opened. -->
        <Border x:Name="TransferPanel" DockPanel.Dock="Top" Background="{StaticResource CardBackground}"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="CancelTransferButton" DockPanel.Dock="Right" Content="Cancel" VerticalAlignment="Center"
                        Click="OnCancelTransferClicked" />
                <StackPanel Margin="0,0,14,0">
                    <TextBlock x:Name="TransferText" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="TransferProgress" Margin="0,8,0,0" Minimum="0" Maximum="1" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock x:Name="NoticeText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                   Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

        <Grid>
            <Border Style="{StaticResource Card}" Padding="6" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
                <ListBox x:Name="FileList" MouseDoubleClick="OnRowDoubleClick"
                         PreviewMouseRightButtonDown="OnRowRightClick" ContextMenuOpening="OnContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="OpenItem" Header="Open" Click="OnOpenClicked" />
                            <MenuItem x:Name="SaveCopyItem" Header="Save a copy…" Click="OnSaveCopyClicked" />
                            <MenuItem x:Name="RenameItem" Header="Rename…" Click="OnRenameClicked" />
                            <MenuItem x:Name="TrashItem" Header="Move to trash" Click="OnTrashClicked" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{Binding GlyphBrush}" Width="24" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource PrimaryText}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Caption}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding DateText}" Style="{StaticResource Caption}"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="380" IsHitTestVisible="False">
                <TextBlock x:Name="EmptyTitle" Text="Nothing here yet" FontSize="16" HorizontalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}" />
                <TextBlock x:Name="EmptyDetail" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0"
                           Text="Drop files onto this list, or press Add files." />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
