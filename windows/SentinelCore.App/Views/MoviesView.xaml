<UserControl x:Class="SentinelCore.App.Views.MoviesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="20,16,20,0">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Movies" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="Loading the library…" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="HomeTab" Content="Home" Click="OnTabClicked" Tag="home" />
                <Button x:Name="MoviesTab" Content="Movies" Margin="6,0,0,0" Click="OnTabClicked" Tag="movie" />
                <Button x:Name="ShowsTab" Content="TV Shows" Margin="6,0,0,0" Click="OnTabClicked" Tag="show" />
                <Button x:Name="SurpriseButton" Content="Surprise me" Margin="14,0,0,0" Click="OnSurpriseClicked"
                        ToolTip="Pick something to watch at random" />
                <!-- Movie downloads: only while the server says this user may add (status.canDownload). -->
                <!-- The VPN light: a dot and a few words ("VPN · SE"); click for Downloads, which says more. -->
                <Button x:Name="VpnLightButton" Margin="14,0,0,0" Padding="10,5" Visibility="Collapsed"
                        Click="OnDownloadsClicked">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="VpnLightDot" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{StaticResource SecondaryText}" />
                        <TextBlock x:Name="VpnLightText" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddButton" Content="+ Add" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}"
                        Visibility="Collapsed" Click="OnAddClicked"
                        ToolTip="Find a movie or TV episodes and download them into the library" />
                <Button x:Name="ImportButton" Content="Import a list" Margin="6,0,0,0" Visibility="Collapsed"
                        Click="OnImportClicked"
                        ToolTip="Download everything on a Letterboxd or IMDb list you exported" />
                <Button x:Name="DownloadsButton" Content="Downloads" Margin="6,0,0,0" Visibility="Collapsed"
                        Click="OnDownloadsClicked" ToolTip="What is downloading, and what arrived recently" />
                <TextBox x:Name="SearchBox" Width="220" Margin="14,0,0,0" TextChanged="OnSearchChanged"
                         ToolTip="Search titles" />
                <Button Margin="8,0,0,0" Padding="10,6" Click="OnRefreshClicked" ToolTip="Refresh now">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Sort and filter, for the Movies and TV Shows grids (and search results). -->
        <StackPanel x:Name="FilterBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14"
                    Visibility="Collapsed">
            <TextBlock Text="Sort" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="SortPicker" Width="150" SelectionChanged="OnSortChanged" />
            <Button x:Name="OrderButton" Margin="6,0,0,0" Padding="10,6" Click="OnOrderClicked"
                    ToolTip="Ascending or descending" />
            <TextBlock Text="Genre" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox x:Name="GenrePicker" Width="170" SelectionChanged="OnGenreChanged" />
            <CheckBox x:Name="UnwatchedBox" Content="Unwatched only" Margin="16,0,0,0"
                      Checked="OnUnwatchedChanged" Unchecked="OnUnwatchedChanged" />
            <CheckBox x:Name="MyListBox" Content="My List" Margin="16,0,0,0"
                      Checked="OnMyListChanged" Unchecked="OnMyListChanged" />
            <TextBlock x:Name="CountText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="NoticeText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                   Margin="0,8,0,10" Visibility="Collapsed" />

        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentHost" Margin="0,0,0,16" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="420">
                <TextBlock x:Name="EmptyTitle" FontSize="16" HorizontalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}" />
                <TextBlock x:Name="EmptyMessage" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0" />
                <Button x:Name="EmptyLibrariesButton" Content="Movies &amp; TV libraries…" HorizontalAlignment="Center"
                        Margin="0,14,0,0" Style="{StaticResource PrimaryButton}" Visibility="Collapsed"
                        Click="OnEmptyLibrariesClicked" />
            </StackPanel>

            <!-- Search found nothing: offer to download what was typed instead
                 (core/docs/MOVIE_DOWNLOADS.md, "Search offers a download"). -->
            <ScrollViewer x:Name="OfferScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <!-- Stretched up to MaxWidth, which WPF centres. -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" MaxWidth="560" Margin="0,24,0,16">
                    <StackPanel>
                        <TextBlock x:Name="OfferTitle" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                        <TextBlock x:Name="OfferLine" Style="{StaticResource BodyText}" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <!-- TMDB matches of every kind; only with a TMDB key. -->
                        <StackPanel x:Name="OfferLookupPanel" Margin="0,12,0,0">
                            <TextBlock x:Name="OfferLookupStatus" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Margin="0,0,0,8" Visibility="Collapsed" />
                            <StackPanel x:Name="OfferResultsHost" />
                        </StackPanel>

                        <!-- Always: search the sites for exactly what was typed, as one of the known kinds. -->
                        <TextBlock x:Name="OfferSitesLine" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <WrapPanel x:Name="OfferKindButtons" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
