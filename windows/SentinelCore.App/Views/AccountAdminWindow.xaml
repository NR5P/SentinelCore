<Window x:Class="SentinelCore.App.Views.AccountAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Manage Accounts" Height="620" Width="760" MinHeight="460" MinWidth="620">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <StackPanel>
                <TextBlock Text="Accounts" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Green}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Text="An Admin can change anything; a Viewer can watch cameras and read events, and nothing else." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="480" />
                <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" Click="OnCloseClicked" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Text="ADD AN ACCOUNT" Style="{StaticResource GroupHeading}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Username" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox x:Name="NewUsername" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Display name (optional)" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <TextBox x:Name="NewDisplayName" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Password" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="NewPassword" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Role" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <ComboBox x:Name="NewRole" SelectedIndex="1">
                            <ComboBoxItem Content="Admin" />
                            <ComboBoxItem Content="Viewer" />
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="4" x:Name="AddButton" Content="Add" VerticalAlignment="Bottom"
                            MinWidth="80" Style="{StaticResource PrimaryButton}" Click="OnAddClicked" />
                </Grid>
            </StackPanel>
        </Border>

        <ListBox x:Name="AccountList" Margin="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,4" CornerRadius="6" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryText}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                           Text="{Binding Detail}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding RoleButtonLabel}" Tag="{Binding}" Click="OnToggleRoleClicked"
                                        ToolTip="Swap this account between Admin and Viewer" />
                                <Button Content="Reset password" Margin="8,0,0,0" Tag="{Binding}"
                                        Click="OnResetPasswordClicked" />
                                <Button Content="Delete" Margin="8,0,0,0" Tag="{Binding}"
                                        Style="{StaticResource DangerButton}" Click="OnDeleteClicked" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
