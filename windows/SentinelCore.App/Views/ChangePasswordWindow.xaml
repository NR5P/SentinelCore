<Window x:Class="SentinelCore.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Change Password" Height="420" Width="440" ResizeMode="NoResize">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="OnCancelClicked" MinWidth="90" />
                <Button x:Name="SaveButton" Content="Save" Margin="10,0,0,0" MinWidth="90"
                        Style="{StaticResource PrimaryButton}" Click="OnSaveClicked" />
            </StackPanel>
        </Border>

        <StackPanel Margin="18">
            <TextBlock Text="Current password" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
            <PasswordBox x:Name="CurrentBox" />

            <TextBlock Text="New password" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="NewBox" PasswordChanged="OnPasswordChanged" />
            <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" Text="At least 8 characters." />

            <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnPasswordChanged" />

            <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" Margin="0,14,0,0"
                       Foreground="{StaticResource Red}" Visibility="Collapsed" />

            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" TextWrapping="Wrap"
                       Text="Changing your password ends every session for this account, including this one - so the app will ask you to sign in again straight afterwards. That is what stops a cookie somebody else is holding from continuing to work." />
        </StackPanel>
    </DockPanel>
</Window>
