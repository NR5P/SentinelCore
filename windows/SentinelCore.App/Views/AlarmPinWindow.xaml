<Window x:Class="SentinelCore.App.Views.AlarmPinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Alarm PIN" Height="220" Width="360" ResizeMode="NoResize">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" Click="OnCancelClicked" />
                <Button Content="OK" Margin="10,0,0,0" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="OnOkClicked" />
            </StackPanel>
        </Border>
        <StackPanel Margin="18">
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Green}" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="{StaticResource Red}" Margin="0,6,0,0" Visibility="Collapsed" />
            <PasswordBox x:Name="PinBox" Margin="0,12,0,0" FontSize="20" MaxLength="8" KeyDown="OnPinKeyDown" />
        </StackPanel>
    </DockPanel>
</Window>
