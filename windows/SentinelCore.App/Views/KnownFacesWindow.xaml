<Window x:Class="SentinelCore.App.Views.KnownFacesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:SentinelCore.App.Design"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Known Faces" Height="640" Width="780" MinHeight="480" MinWidth="620">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Known Faces" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Green}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="People the AI should recognise by name rather than describe as a stranger. More photos, in different light and from different angles, recognise more reliably." />
                </StackPanel>
                <Button Grid.Column="1" Content="Add a person" VerticalAlignment="Center" Click="OnAddPersonClicked" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="520" TextWrapping="Wrap" />
                <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" Click="OnCloseClicked" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FaceList" Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" Margin="0,5" CornerRadius="6" Background="{StaticResource CardBackground}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryText}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Add photo…" Tag="{Binding}" Click="OnAddPhotoClicked" />
                                        <Button Content="Delete" Margin="8,0,0,0" Tag="{Binding}"
                                                Style="{StaticResource DangerButton}" Click="OnDeletePersonClicked" />
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Enrollments}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,10,10">
                                                <Border CornerRadius="6" ClipToBounds="True" Width="104" Height="104"
                                                        Background="#0A0D10">
                                                    <design:RemoteImage SourcePath="{Binding PhotoUrl}"
                                                                        DecodeWidth="220" Stretch="UniformToFill" />
                                                </Border>
                                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                        FontSize="10" Padding="5,2" HorizontalAlignment="Right"
                                                        VerticalAlignment="Top" Margin="4" Tag="{Binding}"
                                                        Click="OnDeletePhotoClicked" ToolTip="Remove this photo" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
