<Window x:Class="SentinelCore.App.Views.DashboardLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Dashboard Login" Height="520" Width="560" ResizeMode="CanResize" MinHeight="420" MinWidth="480">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <StackPanel>
                <TextBlock Text="Dashboard Login" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Green}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Text="Whether opening the dashboard requires a login at all." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           MaxWidth="360" HorizontalAlignment="Left" />
                <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" Click="OnCloseClicked" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" />
                    </StackPanel>
                </Border>

                <!-- Turning the requirement on creates the first admin account in the same step:
                     there is deliberately no way to require a login with nobody able to satisfy it. -->
                <Border x:Name="EnablePanel" Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="REQUIRE A LOGIN" Style="{StaticResource GroupHeading}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Switching this on creates the first Admin account at the same time. Everyone opening the dashboard - and every app - has to sign in from then on." />

                        <TextBlock Text="Admin username" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UsernameBox" />

                        <TextBlock Text="Admin password" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordBox" />

                        <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="ConfirmBox" />

                        <Button x:Name="EnableButton" Content="Require a login" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                                Click="OnEnableClicked" />
                    </StackPanel>
                </Border>

                <Border x:Name="DisablePanel" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="STOP REQUIRING A LOGIN" Style="{StaticResource GroupHeading}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Anyone who can reach the dashboard on your network gets full access, with no password - including the cameras, the recordings and every setting. Only sensible on a network you fully control." />
                        <Button x:Name="DisableButton" Content="Stop requiring a login" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Style="{StaticResource DangerButton}"
                                Click="OnDisableClicked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
