<Window x:Class="SentinelCore.App.Views.MediaLibraryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Library" Height="440" Width="580" MinHeight="380" MinWidth="460">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="OnCancelClicked" />
                <Button x:Name="SaveButton" Content="Save" Margin="10,0,0,0" MinWidth="90"
                        Style="{StaticResource PrimaryButton}" Click="OnSaveClicked" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBackground}" Padding="18,10">
            <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" TextWrapping="Wrap" MinHeight="16" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Green}" Margin="0,0,0,10" />

                <TextBlock Text="Kind" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="KindBox" SelectionChanged="OnKindChanged">
                    <ComboBoxItem Content="Movies" Tag="movies" />
                    <ComboBoxItem Content="TV Shows" Tag="shows" />
                </ComboBox>

                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" />
                <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0"
                           Text="How it shows up in the Movies section, e.g. &quot;Movies&quot; or &quot;Kids' TV&quot;." />

                <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0" />
                    <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseClicked" />
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Text="/mnt/movies or smb://PC/Movies - a folder as the server sees it. Browse to pick one on the server or on another computer on the network." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
