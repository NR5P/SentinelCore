<Window x:Class="SentinelCore.App.Views.ServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Server Settings" Height="800" Width="1000" MinHeight="560" MinWidth="760">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Server Settings" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Green}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="Described by the server itself, so a section added there appears here without updating this app." />
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="ShowAdvancedToggle" Content="Show advanced sections"
                          VerticalAlignment="Center" Click="OnShowAdvancedToggled" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="620" TextWrapping="Wrap" />
                <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" Click="OnCloseClicked" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource SidebarBackground}">
                <ItemsControl x:Name="SectionList" Margin="8,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding GroupHeading}" Style="{StaticResource Caption}"
                                           Margin="10,12,0,4" Foreground="{StaticResource Cyan}"
                                           Visibility="{Binding GroupHeadingVisibility}" />
                                <!-- Stretched, so every section name starts at the same left edge:
                                     content alignment alone leaves each button sized to its own
                                     text and centred, which reads as a ragged list. -->
                                <Button Content="{Binding Title}" Tag="{Binding}" Click="OnSectionClicked"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="10,7" Margin="0,1" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
                <StackPanel x:Name="FieldHost" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
