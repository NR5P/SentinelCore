<Window x:Class="SentinelCore.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Sentinel Core" Height="200" Width="430" ResizeMode="NoResize">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" Click="OnCancelClicked" IsCancel="True" />
                <Button x:Name="OkButton" Content="OK" Margin="10,0,0,0" MinWidth="90"
                        Style="{StaticResource PrimaryButton}" Click="OnOkClicked" IsDefault="True" />
            </StackPanel>
        </Border>

        <StackPanel Margin="18">
            <TextBlock x:Name="PromptText" Style="{StaticResource BodyText}" Margin="0,0,0,10" />
            <TextBox x:Name="ValueBox" />
            <PasswordBox x:Name="SecretBox" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
