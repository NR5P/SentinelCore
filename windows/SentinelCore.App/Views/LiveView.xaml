<UserControl x:Class="SentinelCore.App.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="20,16,20,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Live" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="Drag a tile onto another to rearrange the grid. Double-click to open a camera." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Admin only, like every other way of adding a camera - see SetAdminControls. -->
                <Button x:Name="DeviceCameraButton" Padding="10,6" Margin="0,0,8,0" Click="OnDeviceCameraClicked"
                        Visibility="Collapsed" ToolTip="Stream this PC's webcam to the dashboard as a camera">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                        <TextBlock Text="Use this PC as a camera" />
                    </StackPanel>
                </Button>
                <Button Padding="10,6" Click="OnRefreshClicked" ToolTip="Refresh the camera list">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TileHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="360">
                <TextBlock Text="No cameras" FontSize="16" HorizontalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}" />
                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0"
                           Text="Add cameras in Settings → Manage Cameras, or in the Sentinel Core dashboard." />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
