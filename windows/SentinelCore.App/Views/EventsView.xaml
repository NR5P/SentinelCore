<UserControl x:Class="SentinelCore.App.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:design="clr-namespace:SentinelCore.App.Design">

    <DockPanel Margin="20,16,20,16">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Events" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CountText" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="UpdatedText" Style="{StaticResource Caption}" Margin="10,0,0,0" Opacity="0.75" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="230" TextChanged="OnSearchChanged"
                         ToolTip="Search camera, description, zone or event type" />
                <ToggleButton x:Name="NotifiedOnlyToggle" Margin="8,0,0,0" Padding="10,6"
                              Click="OnNotifiedOnlyToggled" Background="{StaticResource CardBackground}"
                              Foreground="{StaticResource PrimaryText}" BorderBrush="{StaticResource CardBorder}"
                              BorderThickness="1" Cursor="Hand"
                              ToolTip="Show only alerts that sent a notification">
                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" />
                </ToggleButton>
                <ToggleButton x:Name="ShowHiddenToggle" Margin="6,0,0,0" Padding="10,6"
                              Click="OnShowHiddenToggled" Background="{StaticResource CardBackground}"
                              Foreground="{StaticResource PrimaryText}" BorderBrush="{StaticResource CardBorder}"
                              BorderThickness="1" Cursor="Hand"
                              ToolTip="Show hidden: motion the AI rejected as nothing, plus anything still awaiting a verdict">
                    <TextBlock Text="&#xED1A;" FontFamily="Segoe MDL2 Assets" />
                </ToggleButton>
                <Button x:Name="RefreshButton" Margin="6,0,0,0" Padding="10,6" Click="OnRefreshClicked"
                        ToolTip="Refresh now">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                   Foreground="{StaticResource Amber}" Margin="0,10,0,0" Visibility="Collapsed" />

        <Grid>
            <ListBox x:Name="EventList" SelectionChanged="OnSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- The notified bar sits in a gutter reserved on every row, filled or
                                 not, so a notified row still lines up with the ones above and
                                 below it rather than shifting everything sideways. -->
                            <Rectangle Grid.Column="0" Width="3" Margin="0,4,10,4" RadiusX="1.5" RadiusY="1.5"
                                       Fill="{Binding NotifiedBarBrush}" />

                            <design:UnlicensedWatermark Grid.Column="1" Width="168" Height="96"
                                                        IsLicensed="{Binding DataContext.IsLicensed,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid>
                                    <Border Background="#0A0D10" CornerRadius="6" />
                                    <design:RemoteImage SourcePath="{Binding ImageUrl}" DecodeWidth="360"
                                                        Stretch="UniformToFill" />
                                    <Border x:Name="ClipBadge" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Margin="6" Padding="6,3" CornerRadius="9" Background="#99000000"
                                            Visibility="{Binding ClipBadge, Converter={StaticResource EmptyStringToVisibility}}">
                                        <TextBlock Text="{Binding ClipBadge}" FontSize="10.5"
                                                   Foreground="{Binding ClipBadgeBrush}" />
                                    </Border>
                                </Grid>
                            </design:UnlicensedWatermark>

                            <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Camera}" FontWeight="SemiBold"
                                               Foreground="{StaticResource Green}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}"
                                               Text="{Binding OccurredAt, Converter={StaticResource RelativeTime}}" />
                                </Grid>

                                <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}"
                                           Margin="0,6,0,0" MaxHeight="56" TextTrimming="CharacterEllipsis"
                                           FontStyle="{Binding DescriptionStyle}"
                                           Foreground="{Binding DescriptionBrush}" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding FooterLabel}" Style="{StaticResource Caption}"
                                               Foreground="{Binding FooterBrush}" VerticalAlignment="Center" />

                                    <!-- Where the row came from: the cameras, the record button, or a
                                         timed window. Every row wears one, or a hand-started clip and
                                         a motion clip would look identical here. -->
                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="8"
                                            BorderThickness="1" BorderBrush="{Binding OriginBrush}"
                                            ToolTip="{Binding OriginTip}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OriginLabel}" FontSize="10" Foreground="{Binding OriginBrush}" />
                                    </Border>

                                    <!-- A camera whose frames are never analyzed produces motion rows
                                         that look exactly like a camera which has stopped seeing
                                         anything worth describing. Saying so on the row is the only
                                         place anyone would notice. -->
                                    <Border Margin="8,0,0,0" Padding="5,2" CornerRadius="8" Background="#2E2415"
                                            Visibility="{Binding IsAiAnalysisOff, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="AI analysis is off for this camera">
                                        <TextBlock Text="AI off" FontSize="10.5" Foreground="{StaticResource Amber}" />
                                    </Border>

                                    <TextBlock Text="{Binding ConfirmationGlyph}" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource Amber}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" ToolTip="{Binding ConfirmationTip}"
                                               Visibility="{Binding ConfirmationGlyph, Converter={StaticResource EmptyStringToVisibility}}" />

                                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" Margin="8,0,0,0"
                                               Foreground="{StaticResource Green}" VerticalAlignment="Center"
                                               ToolTip="Notification sent"
                                               Visibility="{Binding Notified, Converter={StaticResource BoolToVisibility}}" />

                                    <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource Caption}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="420">
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource BodyText}" HorizontalAlignment="Center"
                           FontSize="16" Foreground="{StaticResource SecondaryText}" />
                <TextBlock x:Name="EmptyDescription" Style="{StaticResource Caption}" TextAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
