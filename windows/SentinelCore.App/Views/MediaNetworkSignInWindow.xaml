<Window x:Class="SentinelCore.App.Views.MediaNetworkSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Sign in to a computer" Height="600" Width="540" MinHeight="460" MinWidth="440">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <Button x:Name="ForgetButton" Content="Forget this computer" HorizontalAlignment="Left"
                        Style="{StaticResource DangerButton}" Click="OnForgetClicked" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="OnCancelClicked" />
                    <Button x:Name="SignInButton" Content="Sign in" Margin="10,0,0,0" MinWidth="90" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Click="OnSignInClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBackground}" Padding="18,10">
            <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" TextWrapping="Wrap" MinHeight="16" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <TextBlock x:Name="HeadingText" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Green}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="The server signs in to the other computer itself and reads its shared folders over the network. The sign-in is saved on the server, never on this PC." />

                <TextBlock Text="Computer name or IP address" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="HostBox" />

                <TextBlock Text="Name to show (optional)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" />

                <TextBlock Text="Username on that computer" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="UsernameBox" />
                <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap"
                           Text="Leave blank to sign in as a guest. DOMAIN\name works too." />

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" />
                <TextBlock x:Name="PasswordHint" Style="{StaticResource Caption}" Margin="2,4,0,0"
                           Text="Leave blank to keep the saved password." Visibility="Collapsed" />

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="For a Windows PC, use the Windows account (a Microsoft account works: its email and password). On a Mac, turn on File Sharing. Windows computers don't show up under Find computers — type the PC's name or IP address." />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
