<UserControl x:Class="SentinelCore.App.Views.LiveCameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:live="clr-namespace:SentinelCore.App.Live"
             xmlns:design="clr-namespace:SentinelCore.App.Design">

    <!--
        Just the picture. Every camera-specific control - record, mute, digital zoom, the PTZ pad -
        is drawn inside the player itself (see Live/player.html), because WebView2 is hosted as a
        child window: WPF cannot paint above it, and a click over the video never reaches WPF at
        all. Controls put here would be both invisible and dead.
    -->
    <Grid Background="Black">
        <design:UnlicensedWatermark x:Name="Watermark">
            <live:PlayerHost x:Name="Player" Quality="main" Mode="full" />
        </design:UnlicensedWatermark>
    </Grid>
</UserControl>
