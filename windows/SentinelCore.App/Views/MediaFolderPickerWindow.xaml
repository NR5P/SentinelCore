<Window x:Class="SentinelCore.App.Views.MediaFolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Choose a folder" Height="620" Width="680" MinHeight="440" MinWidth="520">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <StackPanel>
                <TextBlock Text="Choose a folder" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Green}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,10" TextWrapping="Wrap"
                           Text="Folders as the server sees them: on the server itself, or shared by another computer on the network." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UpButton" Grid.Column="0" Padding="10,7" Click="OnUpClicked"
                            ToolTip="Up one folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Up" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="PathBox" Grid.Column="1" Margin="8,0" VerticalContentAlignment="Center"
                             KeyDown="OnPathKeyDown"
                             ToolTip="Type a path and press Enter: /mnt/movies, smb://PC/Movies or \\PC\Movies" />
                    <Button Grid.Column="2" Content="Go" MinWidth="60" Click="OnGoClicked" />
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MessageText" Grid.Column="0" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" MinWidth="90" IsCancel="True" Click="OnCancelClicked" />
                    <Button x:Name="UseButton" Content="Use this folder" Margin="10,0,0,0" MinWidth="120"
                            Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnUseClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentHost" Margin="16,12,16,16" />
        </ScrollViewer>
    </DockPanel>
</Window>
