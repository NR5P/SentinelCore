<UserControl x:Class="SentinelCore.App.Views.DeviceHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="20,16,20,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Device Hub" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="BrokerDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="BrokerText" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddButton" Content="Add device" Click="OnAddClicked" />
                <Button x:Name="DiscoverButton" Content="Discover…" Margin="8,0,0,0" Click="OnDiscoverClicked" />
                <Button Margin="8,0,0,0" Padding="10,6" Click="OnRefreshClicked" ToolTip="Refresh now">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="NoticeText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                   Margin="0,10,0,0" Visibility="Collapsed" />

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="DeviceHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="380">
                <TextBlock Text="No devices yet" FontSize="16" HorizontalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}" />
                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0"
                           Text="Add one by hand, or run a discovery scan to find what is already publishing to your MQTT broker." />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
