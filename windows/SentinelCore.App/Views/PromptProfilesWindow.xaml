<Window x:Class="SentinelCore.App.Views.PromptProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Prompt Profiles" Height="640" Width="860" MinHeight="480" MinWidth="700">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <StackPanel>
                <TextBlock Text="Prompt Profiles" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Green}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="What the AI is asked about a frame, and what it should call an event. A camera's zone settings pick which profile it uses." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="560" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" MinWidth="90" Click="OnCloseClicked" />
                    <Button x:Name="SaveButton" Content="Save" Margin="10,0,0,0" MinWidth="90"
                            Style="{StaticResource PrimaryButton}" Click="OnSaveClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="ProfileList" Margin="12" SelectionChanged="OnProfileSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,8">
                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource PrimaryText}" />
                            <TextBlock Text="{Binding Key}" Style="{StaticResource Caption}"
                                       FontFamily="Consolas, Courier New" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
                    <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox x:Name="DisplayNameBox" />

                    <TextBlock Text="Prompt" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap"
                               Text="What the model is asked about each frame this profile handles." />

                    <TextBlock Text="Notify when" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NotifyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap"
                               Text="The condition that decides whether an analysis becomes a notification. Leave blank to use the server's default." />

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock x:Name="UntouchedText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
