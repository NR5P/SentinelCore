<UserControl x:Class="SentinelCore.App.Views.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="20,16,20,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Alarm" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="BrokerDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="BrokerText" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TestButton" Content="Test" Click="OnTestClicked"
                        ToolTip="Run everything a trigger does, briefly: the siren for five seconds, a notification, the cameras. The mode does not change." />
                <Button x:Name="SettingsButton" Content="Settings…" Margin="8,0,0,0" Click="OnSettingsClicked" />
                <Button x:Name="AddButton" Content="Add sensor" Margin="8,0,0,0" Click="OnAddClicked" />
                <Button Content="Activity…" Margin="8,0,0,0" Click="OnActivityClicked" />
                <Button Margin="8,0,0,0" Padding="10,6" Click="OnRefreshClicked" ToolTip="Refresh now">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" x:Name="StatusCard" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="HeadlineText" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SecondaryText}" />
                <TextBlock x:Name="DetailText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ReadyText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <ItemsControl x:Name="IssuesHost" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="DisarmButton" Content="Disarm" MinWidth="100" Click="OnModeClicked" Tag="disarmed" />
                    <Button x:Name="HomeButton" Content="Home" MinWidth="100" Margin="8,0,0,0" Click="OnModeClicked" Tag="home" />
                    <Button x:Name="NightButton" Content="Night" MinWidth="100" Margin="8,0,0,0" Click="OnModeClicked" Tag="night" />
                    <Button x:Name="AwayButton" Content="Away" MinWidth="100" Margin="8,0,0,0" Click="OnModeClicked" Tag="away" />
                    <Button x:Name="PanicButton" Content="Panic" MinWidth="100" Margin="24,0,0,0"
                            Style="{StaticResource DangerButton}" Click="OnPanicClicked"
                            ToolTip="Set the alarm off right now, whatever mode it is in." />
                </StackPanel>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" Margin="0,10,0,0"
                           Foreground="{StaticResource Amber}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="SensorHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="420">
                <TextBlock Text="No sensors yet" FontSize="16" HorizontalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
