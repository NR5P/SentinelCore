<UserControl x:Class="SentinelCore.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBackground}">

    <Grid>
        <StackPanel MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
                <TextBlock Text="&gt;_" Style="{StaticResource Wordmark}" FontSize="20" Margin="0,0,10,0" />
                <TextBlock Text="SENTINEL_CORE" Style="{StaticResource Wordmark}" FontSize="20" />
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sign in" Style="{StaticResource GroupHeading}" />

                    <TextBlock Text="Username" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBox x:Name="UsernameBox" KeyDown="OnKeyDown" />

                    <TextBlock Text="Password" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                    <PasswordBox x:Name="PasswordBox" KeyDown="OnKeyDown" />

                    <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}"
                               Foreground="{StaticResource Red}" Margin="0,10,0,0" Visibility="Collapsed" />

                    <Button x:Name="SignInButton" Content="Sign In" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnSignInClicked" />
                </StackPanel>
            </Border>

            <Button Content="Use a different server" Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Center" Margin="0,14,0,0" Click="OnChangeServerClicked" />
        </StackPanel>
    </Grid>
</UserControl>
