<Window x:Class="SentinelCore.App.Views.FilesTrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Trash" Height="600" Width="680" MinHeight="400" MinWidth="520">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="380" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="EmptyButton" Content="Empty trash" MinWidth="110"
                            Style="{StaticResource DangerButton}" Click="OnEmptyClicked" />
                    <Button Content="Close" Margin="10,0,0,0" MinWidth="90" Click="OnCloseClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <TextBlock Text="Trash" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Green}" />
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" Margin="0,4,0,14" TextWrapping="Wrap"
                               Text="Files that were removed from the library, or found to be duplicates. Anything here can be put back." />
                    <StackPanel x:Name="BatchHost" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" MaxWidth="360">
                <TextBlock Text="The trash is empty" FontSize="16" HorizontalAlignment="Center"
                           Foreground="{StaticResource SecondaryText}" />
                <TextBlock Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,8,0,0"
                           Text="Files moved to the trash and duplicate copies wait here until the trash is emptied." />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
