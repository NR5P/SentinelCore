<Window x:Class="SentinelCore.App.Views.CameraAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Manage Cameras" Height="620" Width="820" MinHeight="460" MinWidth="640">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cameras" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Green}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                               Text="Stream addresses, credentials, PTZ, and the motion zones that trigger recording." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Add camera" Click="OnAddClicked" />
                    <Button Content="Find cameras…" Margin="8,0,0,0" Click="OnDiscoverClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="560" TextWrapping="Wrap" />
                <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" Click="OnCloseClicked" />
            </Grid>
        </Border>

        <ListBox x:Name="CameraList" Margin="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,4" CornerRadius="6" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryText}" />
                                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="6,2"
                                            Visibility="{Binding PtzVisibility}">
                                        <TextBlock Text="PTZ" FontSize="10.5" Foreground="{StaticResource Cyan}" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Padding="6,2"
                                            Visibility="{Binding AudioVisibility}">
                                        <TextBlock Text="Audio" FontSize="10.5" Foreground="{StaticResource Cyan}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding StreamUrl}" Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Zones" Tag="{Binding}" Click="OnZonesClicked"
                                        ToolTip="Where motion counts, how big it has to be, and when clips are recorded" />
                                <Button Content="Edit" Margin="8,0,0,0" Tag="{Binding}" Click="OnEditClicked" />
                                <Button Content="Delete" Margin="8,0,0,0" Tag="{Binding}"
                                        Style="{StaticResource DangerButton}" Click="OnDeleteClicked" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
