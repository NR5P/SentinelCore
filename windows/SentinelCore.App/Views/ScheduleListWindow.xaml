<Window x:Class="SentinelCore.App.Views.ScheduleListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Schedules" Height="660" Width="880" MinHeight="480" MinWidth="700">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Schedules" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Green}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="Switch a device, publish MQTT, or call an API endpoint at a time of your choosing — or at sunset, or when it gets dark." />
                </StackPanel>
                <Button Grid.Column="1" Content="Add a schedule" VerticalAlignment="Center" Click="OnAddClicked" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="620" TextWrapping="Wrap" />
                <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" Click="OnCloseClicked" />
            </Grid>
        </Border>

        <ListBox x:Name="ScheduleList" Margin="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Margin="0,4" CornerRadius="6" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{Binding NameBrush}" />
                                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" Padding="6,2">
                                        <TextBlock Text="{Binding StateLabel}" FontSize="10.5"
                                                   Foreground="{Binding StateBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Timing}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding Action}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding LastRun}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                           Foreground="{Binding LastRunBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{Binding ToggleLabel}" Tag="{Binding}" Click="OnToggleClicked" />
                                <Button Content="Run now" Margin="8,0,0,0" Tag="{Binding}" Click="OnRunClicked"
                                        ToolTip="Fires the action immediately, ignoring the timing" />
                                <Button Content="Edit" Margin="8,0,0,0" Tag="{Binding}" Click="OnEditClicked" />
                                <Button Content="Delete" Margin="8,0,0,0" Tag="{Binding}"
                                        Style="{StaticResource DangerButton}" Click="OnDeleteClicked" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
