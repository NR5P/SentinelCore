<Window x:Class="SentinelCore.App.Views.KnownVehiclesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Known Vehicles" Height="560" Width="620" MinHeight="420" MinWidth="520">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <StackPanel>
                <TextBlock Text="Known Vehicles" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Green}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="Number plates the AI treats as household rather than a stranger's. The plate is the identity - two rows with the same one would be the same vehicle twice." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="330" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" MinWidth="90" Click="OnCloseClicked" />
                    <Button x:Name="SaveButton" Content="Save" Margin="10,0,0,0" MinWidth="90"
                            Style="{StaticResource PrimaryButton}" Click="OnSaveClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Plate" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBox x:Name="PlateBox" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Label" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBox x:Name="LabelBox" />
                </StackPanel>
                <Button Grid.Column="2" Content="Add" VerticalAlignment="Bottom" MinWidth="80" Click="OnAddClicked" />
            </Grid>
        </Border>

        <ListBox x:Name="VehicleList" Margin="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,4" CornerRadius="6" Background="{StaticResource CardBackground}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Plate}" FontFamily="Consolas, Courier New"
                                       FontWeight="Bold" Foreground="{StaticResource Cyan}" VerticalAlignment="Center"
                                       MinWidth="130" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryText}" Margin="12,0,0,0" />
                            <Button Grid.Column="2" Content="Remove" Tag="{Binding}" Click="OnRemoveClicked"
                                    Style="{StaticResource DangerButton}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
