<Window x:Class="SentinelCore.App.Views.MediaDownloadSitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Torrent sites" Height="620" Width="720" MinHeight="440" MinWidth="540">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="Torrent sites" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Green}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="The sites searched when anyone adds a movie or show. Prowlarr keeps them working; everything goes through the VPN." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <Button x:Name="AddSiteButton" Content="Add a site…" HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButton}" Click="OnAddSiteClicked" IsEnabled="False" />
                <Button Content="Close" HorizontalAlignment="Right" MinWidth="90" IsCancel="True" Click="OnCloseClicked" />
            </Grid>
        </Border>

        <!-- The VPN may still be coming up: the server's "Connecting..." sentence while this asks again. -->
        <Border x:Name="BusyBar" DockPanel.Dock="Top" Background="#14241C" CornerRadius="6" Padding="14,10"
                Margin="18,12,18,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="BusyText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="MessageText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Margin="18,6,18,8" Visibility="Collapsed" />

        <Grid Margin="18,12,18,0">
            <!-- Your sites -->
            <Grid x:Name="ListPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SitesHost" Margin="0,0,0,12" />
                </ScrollViewer>
                <TextBlock x:Name="ListEmpty" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                           VerticalAlignment="Top" Margin="0,30,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="420" Visibility="Collapsed" Text="No sites yet. Add one to start searching." />
            </Grid>

            <!-- The catalog of sites that can be added -->
            <DockPanel x:Name="CatalogPanel" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="← Your sites" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                            Click="OnShowListClicked" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CatalogQueryBox" KeyDown="OnCatalogQueryKeyDown" ToolTip="Site name" />
                        <Button x:Name="CatalogFindButton" Grid.Column="1" Content="Find" MinWidth="80" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}" Click="OnCatalogFindClicked" />
                    </Grid>
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <ScrollViewer x:Name="CatalogScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CatalogHost" Margin="0,0,0,12" />
                    </ScrollViewer>
                    <TextBlock x:Name="CatalogStatus" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Margin="0,30,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="420" Visibility="Collapsed" />
                </Grid>
            </DockPanel>

            <!-- Setting up a site that needs a login or choices -->
            <DockPanel x:Name="FormPanel" Visibility="Collapsed">
                <Button DockPanel.Dock="Top" Content="← All sites" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Click="OnShowCatalogClicked" />
                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,12">
                    <TextBlock x:Name="FormError" Foreground="{StaticResource Red}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,120,0" />
                    <Button x:Name="SaveSiteButton" Content="Add site" HorizontalAlignment="Right" MinWidth="100"
                            Style="{StaticResource PrimaryButton}" Click="OnSaveSiteClicked" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,6,0,12">
                        <TextBlock x:Name="FormName" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                        <TextBlock x:Name="FormDescription" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <StackPanel x:Name="FieldsHost" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
