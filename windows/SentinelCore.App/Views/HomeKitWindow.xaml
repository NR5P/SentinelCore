<Window x:Class="SentinelCore.App.Views.HomeKitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Dialog}"
        WindowStartupLocation="CenterOwner"
        Title="Apple HomeKit" Height="640" Width="560" MinHeight="520" MinWidth="480">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="MessageText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="300" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" MinWidth="90" Click="OnCloseClicked" />
                    <Button x:Name="SaveButton" Content="Save" Margin="10,0,0,0" MinWidth="90"
                            Style="{StaticResource PrimaryButton}" Click="OnSaveClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <TextBlock Text="Apple HomeKit" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Green}" Margin="0,0,0,14" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource GroupHeading}" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" />

                        <!-- The pairing code is the useful half of this screen, and no settings
                             schema can describe it - which is why this section is hand-written
                             rather than schema-driven like the rest. -->
                        <Border x:Name="PairingPanel" Margin="0,14,0,0" Padding="14" CornerRadius="6"
                                Background="{StaticResource InputBackground}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Pairing code" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="PairingCodeText" FontFamily="Consolas, Courier New"
                                           FontSize="26" FontWeight="Bold" Foreground="{StaticResource Cyan}"
                                           Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="In the Home app on an iPhone or iPad: Add Accessory, then More options, and pick this bridge. Enter the code above." />
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="AccessoryList" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource GroupHeading}" />

                        <CheckBox x:Name="EnabledToggle" Content="Publish to HomeKit" />
                        <TextBlock Style="{StaticResource Caption}" Margin="26,4,0,0" TextWrapping="Wrap"
                                   Text="The sidecar runs either way; this is what makes it advertise itself on the network." />

                        <CheckBox x:Name="IncludeDevicesToggle" Content="Include Device Hub" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="26,4,0,0" TextWrapping="Wrap"
                                   Text="Your Device Hub lights, switches, outlets, fans, locks and gates appear in Home too." />

                        <CheckBox x:Name="IncludeVideoToggle" Content="Live video in Home" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="26,4,0,0" TextWrapping="Wrap"
                                   Text="Each camera becomes a HomeKit camera you can watch live in Home. Watching away from home needs a home hub (an Apple TV or HomePod)." />

                        <TextBlock Text="Sidecar address" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SidecarBox" />

                        <TextBlock Text="Timeout (seconds)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TimeoutBox" />

                        <TextBlock Text="Minimum confidence" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ConfidenceBox" />
                        <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0"
                                   Text="Between 0 and 1. Detections below this are not reported to HomeKit." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="PAIRING" Style="{StaticResource GroupHeading}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Resetting drops the pairing entirely. Every Home app on the network has to pair again with a new code." />
                        <Button x:Name="ResetButton" Content="Reset the HomeKit pairing" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Style="{StaticResource DangerButton}"
                                Click="OnResetClicked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
