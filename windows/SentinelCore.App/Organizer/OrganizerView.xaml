<UserControl x:Class="SentinelCore.App.Organizer.OrganizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="20,16,20,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Organizer" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="SyncDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="SyncText" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Showing" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SpaceFilter" MinWidth="170" SelectionChanged="OnSpaceFilterChanged"
                          ToolTip="Which space's things to show" />
                <Button Margin="8,0,0,0" Padding="10,6" Click="OnSyncClicked" ToolTip="Sync now">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- The server answering isn't the one this PC last synced with: nothing is sent until the
             person says what to do. See OrganizerEngine.ResolveResetAsync. "Not now" is remembered for
             this server (OrganizerEngine.DeclineReset); the banner then offers the question back. -->
        <Border x:Name="ResetBanner" DockPanel.Dock="Top" Background="#2A2214" CornerRadius="6" Padding="14,10"
                Margin="0,0,0,10" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UploadCopyButton" Content="Upload this PC's copy" Style="{StaticResource PrimaryButton}" Click="OnUploadCopyClicked" />
                    <Button x:Name="UseServerCopyButton" Content="Use the server's" Margin="8,0,0,0" Click="OnUseServerCopyClicked" />
                    <Button x:Name="NotNowButton" Content="Not now" Margin="8,0,0,0" Click="OnNotNowClicked" />
                    <Button x:Name="DecideButton" Content="Decide" Margin="8,0,0,0" Click="OnDecideClicked" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="ResetText" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,14,0"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Background="#2A1417" CornerRadius="6" Padding="14,8"
                Margin="0,0,0,10" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Click="OnDismissErrorClicked" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
            <TabItem x:Name="CalendarTab" Header="Calendar" />
            <TabItem x:Name="RemindersTab" Header="Reminders" />
            <TabItem x:Name="NotesTab" Header="Notes" />
            <TabItem x:Name="BoardsTab" Header="Boards" />
        </TabControl>
    </DockPanel>
</UserControl>
