<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches getExternalCacheDir()/captures used by TakePicture() for Known Face enrollment. -->
    <external-cache-path name="captures" path="captures/" />
    <!-- Organizer attachments copied out under their own names so another app can open them. -->
    <cache-path name="organizer" path="organizer-open/" />
    <!-- Files-library downloads, copied out under their real names for Open and Share. -->
    <cache-path name="files" path="files-open/" />
    <!-- Podcast clips and OPML exports, handed to the share sheet (ui/podcasts). -->
    <cache-path name="audio" path="audio-share/" />
</paths>
