<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only needed for taking a new reference photo when enrolling a Known Face - picking an
         existing photo uses the system Photo Picker instead, which needs no permission. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Using this phone as one of the dashboard's cameras (see publish/DevicePublisher): the
         microphone only if the person includes it; the foreground service and its camera and
         microphone types are what let the stream keep running with the screen off; the wake lock
         keeps the CPU up for it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Organizer reminder and event alerts are raised on the phone itself (organizer/
         OrganizerAlarms) so they fire with no signal. Exact timing needs the person's say-so on
         Android 12+ (Settings, Alarms & reminders); without it they arrive within a few minutes.
         Alarms are cleared by a reboot, hence the boot receiver that puts them back. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SentinelCore.Starting"
        android:usesCleartextTraffic="true">
        <service
            android:name=".publish.DevicePublisherService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <service
            android:name=".push.SentinelFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".organizer.OrganizerAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".organizer.OrganizerBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The alarm at a glance (widgets/AlarmWidget). -->
        <receiver
            android:name=".widgets.AlarmWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_alarm_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alarm_widget" />
        </receiver>

        <!-- Organizer widgets for the home screen (widgets/OrganizerWidgets). -->
        <receiver
            android:name=".widgets.OrganizerCalendarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/organizer_calendar_widget" />
        </receiver>
        <receiver
            android:name=".widgets.OrganizerRemindersWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_reminders_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/organizer_reminders_widget" />
        </receiver>
        <receiver
            android:name=".widgets.OrganizerNotesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_notes_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/organizer_notes_widget" />
        </receiver>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/security_alert_channel_id" />
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Sentinel Core" in other apps' Share menus: text or a link becomes an Organizer
                 note in the person's own space - see organizer/VoiceCapture.sharedNote. -->
            <intent-filter android:label="@string/share_note_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Voice reminder / voice note on the icon's long-press menu, and the Google
                 Assistant App Action - see res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Lets ActivityResultContracts.TakePicture() write a captured photo to a content Uri
             this app can read back, for Known Face enrollment - the camera app itself can't
             write directly to our private storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
