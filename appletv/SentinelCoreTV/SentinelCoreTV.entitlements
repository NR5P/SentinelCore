<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- "aps-environment", not the "com.apple.developer.aps-environment" spelling the macOS
         build of the iOS app uses: tvOS takes the plain key, same as iOS device builds (see
         ios/SentinelCore/SentinelCore-iOS.entitlements). With the macOS spelling, codesign
         drops the key entirely - the provisioning profile never grants it - and the app fails
         APNs registration at launch with "no valid aps-environment entitlement string found",
         so every push, and with it the cold-start alert takeover, silently never arrives. -->
    <key>aps-environment</key>
    <string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
