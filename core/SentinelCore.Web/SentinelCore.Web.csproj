<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SentinelCore/SentinelCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <!-- The "New" fork (jdomnitz/net-mdns) rather than the original Makaretu.Dns.Multicast: the
         original hasn't published since 2019, while this fork ships an actively maintained
         net8.0/net9.0-targeted build - used here to advertise this server over mDNS/DNS-SD so
         the mobile apps can find it on the LAN instead of the user typing an IP address. -->
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="PureHDF" Version="2.2.0" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
    <PackageReference Include="SMBLibrary" Version="1.5.8.1" />
    <!-- SFTP delivery for the nightly auto export (AutoExport.cs), so a backup can reach another
         computer without that computer's share being mounted here first. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- Music tags and embedded cover art (MusicTags.cs): ID3, Vorbis comments, MP4 atoms, APE
         and ASF, read through a stream so files on network shares work too. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>
  <!-- The SDK's default item globs otherwise sweep up whatever's sitting in the runtime data/
       folder next to this project (events.db, images, cameras.db, ...) as Content purely
       because it's inside the project directory - confirmed accidentally shipping data/
       heartbeat.json into a `dotnet publish` output. None of it belongs in a build output. -->
  <ItemGroup>
    <Content Remove="data/**" />
    <None Remove="data/**" />
  </ItemGroup>

  <!-- The SentinelCore ProjectReference above is only for its C# types (EventStore,
       PromptProfileProvider, ...) - not its content. But the SDK flows a referenced project's
       own appsettings*.json into this project's publish output too, since it's an executable
       with the same Sdk.Web-generated Content items as this one. That's silently harmless for a
       normal multi-file publish (both projects publish to separate folders anyway - this file
       never gets used), but scripts/publish-release.sh's single-file publish hard-fails on it
       (NETSDK1152: two source files claiming the same output path). Drop SentinelCore's copy
       here and keep only this project's own appsettings.json. -->
  <Target Name="RemoveSentinelCoreAppSettingsFromPublishOutput" AfterTargets="ComputeFilesToPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json' and '%(ResolvedFileToPublish.FullPath)' != '$(MSBuildProjectDirectory)\appsettings.json' and '%(ResolvedFileToPublish.FullPath)' != '$(MSBuildProjectDirectory)/appsettings.json'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Development.json'" />
    </ItemGroup>
  </Target>
</Project>
