<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <!-- Deliberately references only the two small libraries, never SentinelCore itself: this is
       the vendor-operated service that holds the real APNs/FCM keys, and it should carry nothing
       it doesn't need - no vision models, no camera code, no SQLite of events. It is also not part
       of any release bundle (see scripts/publish-release.sh). -->
  <ItemGroup>
    <ProjectReference Include="../SentinelCore.Push/SentinelCore.Push.csproj" />
    <ProjectReference Include="../SentinelCore.Licensing/SentinelCore.Licensing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <!-- Renders the privacy policy for the two public pages (PublicPages.cs). Same package the
         dashboard already uses for its own markdown. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>
  <!-- The store-facing privacy policy lives with the other cross-platform docs and is embedded
       here so nr5p.com/privacy always serves exactly what the repo says, with no copy to forget. -->
  <ItemGroup>
    <EmbeddedResource Include="../../docs/PRIVACY_POLICY.md" LogicalName="PRIVACY_POLICY.md" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="data/**" />
    <None Remove="data/**" />
  </ItemGroup>
</Project>
