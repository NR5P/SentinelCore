<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LicenseGenerator.Gui.MainWindow"
        Title="SentinelCore Licenses"
        Width="860" Height="700" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#20FFFFFF" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="20,16" Background="#18FFFFFF">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Image Source="avares://LicenseGenerator.Gui/Assets/AppIcon.png" Width="44" Height="44" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SentinelCore Licenses" FontSize="19" FontWeight="Bold" />
          <TextBlock Text="Issue, check and block Sentinel Core licenses." Opacity="0.7" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TabControl Margin="12">

      <!-- ISSUE -->
      <TabItem Header="Issue a license">
        <ScrollViewer>
          <StackPanel Spacing="18" Margin="8,14,8,8">

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="Signing key" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="KeyPathBox" AutomationProperties.Name="Signing key path" Grid.Column="0" IsReadOnly="True"
                         Watermark="Choose the private.pem you sign licenses with" />
                <Button Name="BrowseKeyButton" AutomationProperties.Name="Choose signing key" Grid.Column="1" Content="Choose…" Margin="8,0,0,0" />
              </Grid>
              <Border Name="KeyStatusBorder" CornerRadius="6" Padding="10,8" IsVisible="False">
                <TextBlock Name="KeyStatusText" AutomationProperties.Name="Signing key status" TextWrapping="Wrap" FontSize="12" />
              </Border>
            </StackPanel>

            <Border Classes="card">
              <StackPanel Spacing="14">
                <StackPanel>
                  <TextBlock Classes="label" Text="Customer name" />
                  <TextBox Name="CustomerBox" AutomationProperties.Name="Customer name" Watermark="Jane Doe" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="label" Text="Customer email" />
                  <TextBox Name="EmailBox" AutomationProperties.Name="Customer email" Watermark="jane@example.com" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="label" Text="Product" />
                  <TextBox Name="ProductBox" AutomationProperties.Name="Product" Text="SentinelCore" />
                </StackPanel>
              </StackPanel>
            </Border>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="Save the .lic file to" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="OutputDirBox" AutomationProperties.Name="Output folder" Grid.Column="0" IsReadOnly="True" />
                <Button Name="BrowseOutputButton" AutomationProperties.Name="Choose output folder" Grid.Column="1" Content="Choose…" Margin="8,0,0,0" />
              </Grid>
              <TextBox Name="FileNameBox" AutomationProperties.Name="License file name" Watermark="jane-doe.lic" />
              <TextBlock Classes="hint"
                         Text="Named after the customer automatically. Edit it if you'd rather call it something else." />
            </StackPanel>

            <Button Name="IssueButton" AutomationProperties.Name="Issue license" Content="Issue license"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="0,12" FontWeight="SemiBold" />

            <Border Name="IssueResultBorder" CornerRadius="6" Padding="14" IsVisible="False">
              <StackPanel Spacing="10">
                <TextBlock Name="IssueResultText" AutomationProperties.Name="Issue result" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="RevealButton" AutomationProperties.Name="Show in folder" Content="Show in folder" />
                  <Button Name="CopyPathButton" AutomationProperties.Name="Copy path" Content="Copy path" />
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- VERIFY -->
      <TabItem Header="Verify">
        <ScrollViewer>
          <StackPanel Spacing="16" Margin="8,14,8,8">
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="Check a .lic file against the public key compiled into SentinelCore - the same check the customer's server does. Use it to confirm a license before you email it, or to work out why one a customer sent back isn't being accepted." />
            <Button Name="VerifyBrowseButton" AutomationProperties.Name="Choose a license to verify" Content="Choose a .lic file…" HorizontalAlignment="Left" />
            <Border Name="VerifyResultBorder" CornerRadius="6" Padding="14" IsVisible="False">
              <SelectableTextBlock Name="VerifyResultText" AutomationProperties.Name="Verification result" TextWrapping="Wrap" FontFamily="monospace" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- BLOCKED -->
      <TabItem Header="Blocked licenses">
        <ScrollViewer>
          <StackPanel Spacing="16" Margin="8,14,8,8">
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="Cut a license off from the push notification service - for a refund, a chargeback, or a license file that's been shared around. Its phones stop getting alerts right away and it can't register new ones. It's reversible, and it only affects push: the license keeps working on the customer's own server." />

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="label" Text="Relay server" />
                <StackPanel>
                  <TextBlock FontSize="12" Text="Server (user@host, or a Host from ~/.ssh/config)" Margin="0,0,0,4" />
                  <TextBox Name="RelayTargetBox" AutomationProperties.Name="Relay server" Watermark="user@host" />
                </StackPanel>
                <StackPanel>
                  <TextBlock FontSize="12" Text="Relay settings file on that server" Margin="0,0,0,4" />
                  <TextBox Name="RelayPathBox" AutomationProperties.Name="Relay settings file path" />
                </StackPanel>
                <StackPanel>
                  <TextBlock FontSize="12" Text="Relay service name (systemd)" Margin="0,0,0,4" />
                  <TextBox Name="RelayServiceBox" AutomationProperties.Name="Relay service name" />
                </StackPanel>
                <TextBlock Classes="hint"
                           Text="Uses this Mac's own ssh and keys - nothing is stored here but these three fields. For a different port, key or jump host, add a Host entry to ~/.ssh/config and put its name above. Leave the service name empty if the relay doesn't run under systemd; changes then save but aren't confirmed." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="RelayConnectButton" AutomationProperties.Name="Test connection and load the blocked list" Content="Connect" />
                  <Button Name="RelayDefaultsButton" AutomationProperties.Name="Reset relay settings to defaults" Content="Reset to defaults" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Name="BlockStatusBorder" CornerRadius="6" Padding="12" IsVisible="False">
              <SelectableTextBlock Name="BlockStatusText" AutomationProperties.Name="Blocked list status" TextWrapping="Wrap" />
            </Border>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="Blocked right now" />
              <ListBox Name="BlockedList" AutomationProperties.Name="Blocked licenses" MinHeight="90" MaxHeight="220" />
              <Button Name="UnblockButton" AutomationProperties.Name="Unblock the selected license" Content="Unblock selected" HorizontalAlignment="Left" />
            </StackPanel>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="label" Text="Block a license" />
                <StackPanel>
                  <TextBlock FontSize="12" Text="From your issued licenses" Margin="0,0,0,4" />
                  <Grid ColumnDefinitions="*,Auto">
                    <ComboBox Name="IssuedCombo" AutomationProperties.Name="Issued licenses" Grid.Column="0" HorizontalAlignment="Stretch"
                              PlaceholderText="Choose a customer" />
                    <Button Name="BlockIssuedButton" AutomationProperties.Name="Block the chosen customer's license" Grid.Column="1" Content="Block" Margin="8,0,0,0" />
                  </Grid>
                </StackPanel>
                <StackPanel>
                  <TextBlock FontSize="12" Text="By license id" Margin="0,0,0,4" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="BlockIdBox" AutomationProperties.Name="License id to block" Grid.Column="0"
                             Watermark="3f2a1c9e-0b7d-4e2a-9c51-6d8f0e4b2a17" />
                    <Button Name="BlockIdButton" AutomationProperties.Name="Block this license id" Grid.Column="1" Content="Block" Margin="8,0,0,0" />
                  </Grid>
                </StackPanel>
                <Button Name="BlockFileButton" AutomationProperties.Name="Block the license in a .lic file" Content="Block from a .lic file…" HorizontalAlignment="Left" />
                <TextBlock Name="LedgerHint" Classes="hint" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- KEY SETUP -->
      <TabItem Header="Key setup">
        <ScrollViewer>
          <StackPanel Spacing="16" Margin="8,14,8,8">

            <Border CornerRadius="6" Padding="14" Background="#33FF6B6B">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="Bold" Text="You almost certainly do not need this." />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="SentinelCore already has a signing key, and its public half is compiled into every copy of the app you have shipped. Generating a second pair does not add a key - it replaces the old one, and every license you have already issued stops verifying the moment the new public key ships. There is no list of who those customers were." />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="Use this only for a brand-new product line, or if the original key is genuinely lost." />
              </StackPanel>
            </Border>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="Create the key pair in" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Name="KeyGenDirBox" AutomationProperties.Name="New key pair folder" Grid.Column="0" IsReadOnly="True" />
                <Button Name="BrowseKeyGenButton" AutomationProperties.Name="Choose new key pair folder" Grid.Column="1" Content="Choose…" Margin="8,0,0,0" />
              </Grid>
            </StackPanel>

            <CheckBox Name="KeyGenConfirmCheck" AutomationProperties.Name="Confirm key replacement is understood"
                      Content="I understand this invalidates every license already issued" />

            <Button Name="GenerateKeysButton" AutomationProperties.Name="Generate a new key pair" Content="Generate a new key pair" />

            <Border Name="KeyGenResultBorder" CornerRadius="6" Padding="14" IsVisible="False">
              <StackPanel Spacing="10">
                <TextBlock Name="KeyGenResultText" AutomationProperties.Name="Key generation result" TextWrapping="Wrap" />
                <SelectableTextBlock Name="KeyGenPublicPem" AutomationProperties.Name="New public key" FontFamily="monospace" FontSize="11" TextWrapping="Wrap" />
                <Button Name="CopyPemButton" AutomationProperties.Name="Copy public key" Content="Copy public key" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
