bin/
obj/
.vs/
.idea/
data/
*.user
*.suo

# License signing key material and issued licenses - never belong in the repo.
*.lic
*.pem

node_modules/

# HomeKit pairing keys and this bridge's stable identity (its virtual MAC + pincode).
# Committing these would hand anyone who cloned the repo the ability to impersonate the
# bridge, and would break every existing iPhone pairing if restored onto another machine.
homekit-bridge/persist/

# The local certificate authority and the server key it signs. The CA private key is the whole
# security of this scheme - anyone holding it can issue certificates every trusting device will
# accept. It is generated per install, automatically, by AutoCertificateProvisioner (see
# SentinelCore.Web) and must never be shared, which is exactly why the product generates one
# itself instead of shipping a bundled certificate.
certs/

# Self-contained per-OS release bundles built by scripts/publish-release.sh - regenerated from
# source, never worth committing.
dist/

# The main app's live configuration. The dashboard writes every camera, credential and alert
# channel into this file, so in a git checkout (which is how a source install runs) it was always
# one commit away from publishing someone's Gmail app password and bot tokens - and it did, more
# than once. What's tracked instead is appsettings.defaults.json, the secret-free starting point;
# ConfigDefaultsSeeder creates appsettings.json from it on first boot and adds any new keys on
# later ones. Anchored so it only ever matches this one file.
/SentinelCore/appsettings.json

# Timestamped copies of a live appsettings.json, made by hand before a risky config change
# (appsettings.json.bak-pretv-20260817-221248 and friends). appsettings.json itself is tracked
# and carries the shipped defaults, so these backups are full copies of one machine's local
# config - broker hosts, SMTP and bot credentials, camera URLs. Untracked but unignored, they
# were one `git add -A` away from being committed.
appsettings.json.bak*

# A test that boots a host without overriding DataDirectory resolves events.db relative to the
# process's working directory, which under `dotnet test` is this one - so a stray zero-byte
# database appears at core/events.db. The real one lives in SentinelCore/data/ and is already
# covered by data/ above. Anchored with a leading slash so it only ever hides this artifact and
# never a database somewhere it would matter.
/events.db

# Output of the automated 6am review (scripts/daily-review/). These must stay untracked:
# the review refuses to commit anything when the working tree is already dirty, so a tracked
# report file would make it permanently unable to ship its own fixes.
daily-reviews/

# Signed Core update bundles the push relay serves (SentinelCore.PushRelay/updates/), put there
# by scripts/publish-update.sh. Release artifacts, 150 MB apiece - never source.
SentinelCore.PushRelay/updates/

# Machine-specific overrides for scripts/publish-update.sh (the relay's ssh target and folder).
/scripts/local.env
