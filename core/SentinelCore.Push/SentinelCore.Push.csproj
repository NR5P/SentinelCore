<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <!-- The APNs/FCM senders shared by the main app (direct mode) and SentinelCore.PushRelay.
       A framework reference rather than individual Microsoft.Extensions.* packages: both
       consumers are ASP.NET Core apps that already carry the shared framework, so this pins
       nothing they don't have and never drifts from their versions. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
