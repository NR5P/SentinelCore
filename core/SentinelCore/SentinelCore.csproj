<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="ElBruno.LocalEmbeddings.ImageEmbeddings" Version="1.5.3" />
    <PackageReference Include="ElBruno.LocalEmbeddings.ImageEmbeddings.Downloader" Version="1.5.3" />
    <PackageReference Include="FaceAiSharp" Version="0.6.35" />
    <!-- Deliberately NOT FaceAiSharp.Bundle. That metapackage also pulls in
         FaceAiSharp.Models.Scrfd.2dot5g_kps, whose weights come from InsightFace under
         "non-commercial research purposes only" - it shipped in every dist/ zip, which is not
         something we can distribute in a paid product. The ArcFace weights are referenced
         directly instead (Apache-2.0, from the ONNX Model Zoo), and detection is now YuNet
         (MIT) via YuNetFaceDetector. -->
    <PackageReference Include="FaceAiSharp.Models.ArcFace.LResNet100E-IR-int8" Version="0.20230419.1" />
    <!-- The SMTP client. System.Net.Mail.SmtpClient can only do STARTTLS, so a provider that
         offers implicit TLS on port 465 and nothing else (Yandex, Mail.ru, a great many shared
         hosts) simply could not be configured - the connection hung until it timed out. MailKit
         speaks both, and lets a server that wants no authentication at all be used as a relay.
         MIT, as is the BouncyCastle.Cryptography it drags in through MimeKit for S/MIME we
         never use. Messages are still built as System.Net.Mail.MailMessage and converted at
         the point of sending - see SmtpMailer. -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="MQTTnet.Server" Version="5.2.0.1603" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SentinelCore.Licensing/SentinelCore.Licensing.csproj" />
    <ProjectReference Include="../SentinelCore.Push/SentinelCore.Push.csproj" />
  </ItemGroup>
  <!-- The SDK's default item globs otherwise sweep up whatever's sitting in the runtime data/
       folder next to this project (events.db, images, push-devices.db, ...) as Content purely
       because it's inside the project directory - confirmed accidentally shipping data/
       heartbeat.json into a `dotnet publish` output. None of it belongs in a build output. -->
  <!-- YuNet's weights are committed rather than pulled from NuGet: there is no package for them,
       and at 227KB bundling keeps face recognition working offline out of the box. Copied to
       onnx/ so it lands beside the ArcFace model that its NuGet package puts there, which is
       where FaceRecognitionService.ModelPath looks in both normal and single-file publishes. -->
  <ItemGroup>
    <Content Include="models/face_detection_yunet_2023mar.onnx" Link="onnx/face_detection_yunet_2023mar.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="data/**" />
    <None Remove="data/**" />
  </ItemGroup>
</Project>