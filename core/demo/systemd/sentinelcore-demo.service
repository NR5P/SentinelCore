[Unit]
Description=SentinelCore App Review demo - main app (loopback 5091)
After=network-online.target sentinelcore-demo-cams.service

[Service]
Type=simple
WorkingDirectory=@ROOT@/live/ingest
ExecStart=/usr/bin/dotnet @ROOT@/app/SentinelCore/SentinelCore.dll --contentRoot @ROOT@/live/ingest
Environment=ASPNETCORE_ENVIRONMENT=Production
MemoryMax=700M
SyslogIdentifier=sentinelcore-demo
User=scdemo
Group=scdemo
Environment=HOME=@ROOT@
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# The walls: no view of /home (the real install, its keys and settings), nothing writable but
# the demo folder, no privilege gain, so no sudo, systemctl or polkit tricks either.
NoNewPrivileges=yes
# Other users' processes are invisible: the real install's ffmpeg command lines carry camera
# passwords, and /proc would otherwise show them to any user on the box.
ProtectProc=invisible
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@ROOT@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
