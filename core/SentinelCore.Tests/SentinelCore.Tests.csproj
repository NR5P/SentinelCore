<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="xunit.v3" Version="3.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Captured upstream files too awkward to build by hand (a GOES Lightning Mapper NetCDF). -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Both projects are top-level-statement executables, so each has its own global::Program -
         referencing both here would make "Program" ambiguous without these aliases (see
         WebApplicationFactory usage in WebAuthorizationTests.cs and MainAppEndpointTests.cs).
         Each keeps "global" as well so ordinary types from both are usable unqualified. -->
    <ProjectReference Include="../SentinelCore/SentinelCore.csproj" Aliases="global,MainApp" />
    <ProjectReference Include="../SentinelCore.Web/SentinelCore.Web.csproj" Aliases="global,WebHost" />
    <ProjectReference Include="../SentinelCore.PushRelay/SentinelCore.PushRelay.csproj" Aliases="global,RelayHost" />
    <!-- The licensing GUI, for LicenseSigningKeyTests. Only its non-UI signing types are
         exercised - nothing here constructs a window - but referencing the project does drag
         Avalonia's native libraries into this test project's output. That's the price of keeping
         the signing logic in the tool that owns it rather than in the shipped Licensing library,
         which has no business knowing how to load a private key. -->
    <ProjectReference Include="../LicenseGenerator.Gui/LicenseGenerator.Gui.csproj" />
  </ItemGroup>
</Project>
