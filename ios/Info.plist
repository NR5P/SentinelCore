<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sentinel Core</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.sentinelcore.client.organizer-card</string>
			<key>UTTypeDescription</key>
			<string>Organizer card</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.sentinelcore.client.organizer-rule-block</string>
			<key>UTTypeDescription</key>
			<string>Board automation block</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.sentinelcore.client.organizer-refresh</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sentinelcore.client</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sentinelcore</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_sentinelcore._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Sentinel Core uses the camera to stream this device as one of your security cameras, and to take a reference photo when enrolling a known person for face recognition.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sentinel Core uses the microphone when you tap the microphone button to say a reminder, and if you choose to include sound while streaming this device as a security camera.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Sentinel Core turns what you say into a reminder when you tap the microphone button in the Organizer. Speech may be sent to Apple to be recognized.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New Sentinel Core Note</string>
			</dict>
			<key>NSMessage</key>
			<string>newSentinelCoreNote</string>
			<key>NSPortName</key>
			<string>SentinelCore</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>public.url</string>
			</array>
		</dict>
	</array>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Sentinel Core brings reminders from the Apple Reminders list you choose into your Organizer, then removes them from that list. It only does this if you turn it on in Settings.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Sentinel Core brings reminders from the Apple Reminders list you choose into your Organizer, then removes them from that list. It only does this if you turn it on in Settings.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sentinel Core connects to your camera security server and live video streams on your local network.</string>
	<!-- Keeping the Organizer and its Home Screen widgets current while the app is closed: the
	     server's silent push (remote-notification) and a periodic background refresh (fetch).
	     See OrganizerBackgroundRefresh. Music and Podcasts keep playing with the screen locked
	     (audio) - see AudioPlayer. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- CarPlay (SentinelCore/CarPlay/CarPlaySceneDelegate.swift). Only the CarPlay scene is
	     declared; SwiftUI's WindowGroup still supplies the phone's own window. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- CarPlay's Home and Alerts tabs need the Driving Task entitlement. If Apple grants only
	     Audio, set this to false so CarPlay shows Music and Podcasts only. -->
	<key>SentinelCarPlayControls</key>
	<true/>
</dict>
</plist>
