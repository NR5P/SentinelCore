<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- WebRTC (streaming this Mac as a camera, see DevicePublisher) binds UDP sockets for ICE and
         receives the server's connectivity checks on them. Without this the sandbox lets the app
         gather no candidates at all, and every connection fails silently. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Attaching a file to an Organizer note, event or card: the file picker hands the app a
         file the person chose, which the sandbox only lets it read with this. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <!-- "Save a Copy…" on a Family Files file (FileDetailView): the save panel hands the app a
         location the person chose, which the sandbox only lets it write with this. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Apple Reminders as an Organizer inbox (RemindersInbox). EventKit keeps reminders in the
         calendars database, so the sandbox's calendars entitlement is what covers them. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <key>com.apple.developer.aps-environment</key>
    <string>$(APS_ENVIRONMENT)</string>
</dict>
</plist>
